    "require-dev": {
        "drupal/core-dev": "^11.3",
        "drush/drush": "^13.7",
        "phpunit/phpunit": "^11.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/example.gitignore": false,
                "[web-root]/.htaccess": {
                    "append": "assets/scaffold/htaccess-http2-append.txt"
                }
            },
            "allowed-packages": [
                "drupal/drupal_cms_seo_tools"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "./drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "./recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed Drupal CMS!    </>",
                "<bg=blue;fg=white>                                                   </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://drupal.org/support",
                "  * Get involved with the Drupal community: https://drupal.org/getting-involved"
            ]
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        },
        "enable-patching-from-dependencies": true,
        "patches": {
            "drupal/byte_theme": {
                "Custom Byte Theme main.css": "patches/byte_theme_main.patch"
            },
            "drupal/canvas": {
                "Fix TypeError in ComponentMetadataRequirementsChecker closure when example items are not arrays/objects": "patches/canvas-component-metadata-closure-type-fix.patch"
            },
            "drupal/drupal_cms_helper": {
                "form_user_register_form_alter sets the admin-only notify checkbox's #default_value to TRUE unconditionally; on anonymous self-registration that element is #access FALSE, so Form API resolves it to the default and RegisterForm::save() treats every self-registration as admin-created — wrong welcome email (an unusable one-time login link on a blocked pending-approval account) and no pending-approval notification to the admin. Scope the whole alter to the admin-create form": "patches/drupal_cms_helper-scope-register-form-alter-to-admin-create.patch"
            },
            "drupal/mercury": {
                "Preserve custom component prop schema (overlay_opacity on cta; relax overly strict uri-reference format on url/href/cite_url/button_url props that breaks the site-wide 'No URL' sentinel convention and causes Canvas component-version hash drift/OutOfRangeException)": "patches/mercury-component-schema-customizations.patch"
            },
            "drupal/bee": {
                "AddReservationForm empties an existing cart on every new reservation submission, so a customer can never have more than one booking in a cart at a time — stop that, let bookings accumulate like a normal cart (needed for the shh multi-facility package discount)": "patches/bee-accumulate-cart-instead-of-emptying.patch",
                "Attach bat_fullcalendar's standard library instead of the -scheduler variant for hourly types (public node view, staff availability screen, availability form): the scheduler JS hardcodes premium resourceTimeline* toolbar buttons with no schedulerLicenseKey — unlicensed FullCalendar Premium views reachable from every calendar — while every configured view on this platform is the standard dayGridMonth. The standard variant also drops the extra units REST fetch (task 0009)": "patches/bee-use-standard-fullcalendar-not-premium-scheduler.patch",
                "Node edit form alter hardcodes field_price_frequency #default_value to 'hour', silently reverting a 'minute'-priced facility on every staff form save (bee's own hour pricing then computes 0.00 for sub-hour bookings); the branch only runs on edit forms where the widget already has the stored value, so drop the override (task 0043; filed as https://www.drupal.org/project/bee/issues/3610134 - retire this patch when it lands)": "patches/bee-respect-stored-price-frequency-on-edit.patch"
            },
            "drupal/bat_api": {
                "EventsRestResource::get() references $this->eventType, which is never assigned on the class, so bat_api/rest/calendar-events (hit by the FullCalendar widget embedded on every BEE-bookable node view) always fatals with 'Call to a member function usesStates() on null' — use the local $bat_event_type already loaded a few lines above instead, exactly like the rest of the method does": "patches/bat_api-fix-events-rest-resource-undefined-eventtype.patch"
            },
            "drupal/bat": {
                "bat_fullcalendar loads FullCalendar from the jsdelivr CDN at runtime (standard bundle UNPINNED = whatever version jsdelivr serves that day) — point the bat-fullcalendar-cdn library at the locally vendored copy in /libraries/fullcalendar instead (vendored via the fullcalendar/fullcalendar composer repository entry, matching the Webform JS-dependency pattern; task 0009)": "patches/bat_fullcalendar-vendor-local-fullcalendar-library.patch"
            }
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"@unlink('vendor/bin/composer');\""
        ]
    }
}
