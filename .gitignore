# Comprehensive Drupal 11 .gitignore file
# This file excludes sensitive information, user uploads, and dependencies
# while following Drupal 11 best practices for security and performance.

# 🔐 Security & Secrets Protection
# -  All settings files (settings*.php, services*.yml)
# -  Environment variables (.env files)
# -  SSL certificates and SSH keys
# -  API keys and secret files
# -  Database dumps
# -  Hash salt files

# 📦 Dependency Management
# -  Composer: Excludes /vendor/ while keeping composer.json and composer.lock
# -  Node.js: Excludes node_modules/ and build artifacts
# -  Drupal Core: Excludes core when managed via Composer (Drupal 11 best practice)
# -  Contrib modules/themes: Excludes contributed extensions managed via Composer

# 📁 File System Protection
# -  User uploads (sites/*/files/)
# -  Private file systems (sites/*/private/)
# -  Temporary directories
# -  Backup directories
# -  Cache and performance files (CSS/JS aggregation, image styles)

# 🛠 Development Tools
# -  IDE files (PhpStorm, VS Code, Sublime, Vim, Emacs)
# -  Testing frameworks (PHPUnit, Behat)
# -  Development tools (Drush, Drupal Console)
# -  Build and deployment tools
# -  Docker and Vagrant files

# 💻 Operating System Compatibility
# -  macOS files (.DS_Store, etc.)
# -  Windows files (Thumbs.db, etc.)
# -  Linux hidden files

# 🎯 Drupal 11 Specific Features
# -  Both traditional (sites/) and modern (web/sites/) directory structures
# -  Configuration management exclusions
# -  Performance optimization file exclusions
# -  Search API index files

# ✅ Best Practices Included
# -  Clear section organization with headers
# -  Comments explaining what to keep in version control
# -  Flexible exceptions section for custom needs
# -  Support for both single-site and multi-site configurations

# =============================================================================
# COMPOSER DEPENDENCIES
# =============================================================================

# Ignore Composer dependencies - these should be installed via composer install
/vendor/
bin/
drush/contrib/

# Composer files (keep composer.json and composer.lock in version control)
# composer.json - KEEP IN VERSION CONTROL
# composer.lock - KEEP IN VERSION CONTROL

# =============================================================================
# DRUPAL CORE AND CONTRIBUTED MODULES/THEMES
# =============================================================================

# Ignore Drupal core when managing with Composer (recommended for Drupal 11)
core/
web/core/
docroot/core/

# Ignore contributed modules, themes, and profiles (managed via Composer)
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
modules/contrib/
themes/contrib/
profiles/contrib/
docroot/modules/contrib/
docroot/themes/contrib/
docroot/profiles/contrib/
docroot/profiles/varbase/

# Ignore custom modules, themes, and profiles (managed via Github)
web/themes/custom/quick_silver/

# Ignore libraries directory (managed via Composer)
web/libraries/
libraries/
docroot/libraries/

# Recipes
web/recipies/
docroot/recipes/

# Folders where names of files may not be valid
modules/ui_icons_test/icons/name_special_chars/

# =============================================================================
# NODE.JS AND FRONTEND DEPENDENCIES
# =============================================================================

# Node modules and package manager files
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/.yarn/*

# Package manager lock files (keep package.json, decide on lock files based on your workflow)
# package.json - KEEP IN VERSION CONTROL
# package-lock.json - KEEP OR IGNORE based on team preference
# yarn.lock - KEEP OR IGNORE based on team preference
# pnpm-lock.yaml - KEEP OR IGNORE based on team preference

# Build output directories
dist/
build/
.next/
.nuxt/
.vuepress/dist/

# Exception: hestehoj (the only custom theme actually tracked in this
# repo — quick_silver and zwarte_piet are excluded further below as
# independent repos managed via Composer) intentionally commits its
# single compiled Tailwind output file, so the site renders correctly
# without every environment needing a working Node/Yarn toolchain — see
# the matching `!build/main.min.css` rule in the theme's own .gitignore.
# The bare `build/` rule above excludes the directory itself at any
# depth, which silently defeats that per-theme negation — git cannot
# re-include a file inside an already-excluded parent directory — so the
# un-ignore has to happen here too.
!web/themes/custom/hestehoj/build/
web/themes/custom/hestehoj/build/*
!web/themes/custom/hestehoj/build/main.min.css

# =============================================================================
# DRUPAL CONFIGURATION AND SENSITIVE FILES
# =============================================================================

# Settings files that may contain sensitive information
sites/*/settings*.php
web/sites/*/settings*.php
docroot/sites/*/settings*.php
sites/*/settings.local.php
sites/*/settings.local.php
web/sites/*/settings.local.php
docroot/sites/*/settings.local.php

# Services
sites/*/services*.yml
web/sites/*/services*.yml
docroot/sites/*/services*.yml

# Hash salt file
sites/*/salt.txt
web/sites/*/salt.txt

# Local development configuration
.env
.env.local
.env.*.local
*.env

# Database dumps
*.sql
*.sql.gz
*.sql.bz2
*.mysql
*.dump

# =============================================================================
# FILES, PRIVATE FILES, UPLOADS
# =============================================================================

# Public files directory (user uploads)
sites/*/files/*
web/sites/*/files/*
docroot/sites/*/files/*

# Private files directory
private_*/*
sites/*/private_*/
web/sites/*/private_*/
docroot/sites/*/private_*/

# Private files directories: root-level, per-site (this multisite's actual
# convention — see $settings['file_private_path'] in each web/sites/*/settings.php,
# e.g. '../private', '../private_kbg', '../private_shh', resolving to
# repo-root-level private/, private_kbg/, private_shh/ directories, siblings of
# web/). The generic sites/*/private/ patterns above do NOT match these.
/private/*
/private_*/*
# Keep the auto-generated Apache deny-all .htaccess stub tracked (no sensitive
# content, and keeping it version-controlled protects against it ever being
# accidentally deleted) — everything else in these directories is ignored.
!/private/.htaccess
!/private_*/.htaccess

# Temporary files
sites/*/tmp/
web/sites/*/tmp/
docroot/sites/*/tmp/
tmp/

# Backup directories
backup/
backups/
sites/*/backup/
web/sites/*/backup/
docroot/sites/*/backup/

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Multi-site test environment
sites/simpletest/
web/sites/simpletest/
docroot/sites/simpletest/

# PHPUnit and testing
phpunit.xml
.phpunit.result.cache
web/phpunit.xml
docroot/phpunit.xml

# Behat testing
behat.yml
behat.local.yml

################################################################################
# DRUSH / DRUPAL CONSOLE
################################################################################

# Drush
.drush/
drushrc.php
sites/*/drushrc.php
web/sites/*/drushrc.php
docroot/sites/*/drushrc.php

# Drupal console
.console/

# =============================================================================
# IDE AND EDITOR FILES
# =============================================================================

# PhpStorm
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
*.*~
.vim
\#*\#
*.elc
auto-save-list
tramp

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Eclipse
.project
.pydevproject
.settings/
.buildpath

# NetBeans
nbproject/

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
# NOTE: the macOS template's classic `Icon?` pattern (for Finder's custom-
# folder-icon file, literally named "Icon\r") is DELIBERATELY REMOVED. On a
# case-insensitive filesystem with core.ignorecase=true it also matches any
# directory named `icons` -- which silently excluded every custom theme's
# 1,500-file Phosphor icon pack from git, so a fresh clone or a production
# deploy would have shipped with NO icons at all (found 2026-07-13). Git also
# strips a trailing CR when parsing this file, so the name cannot be matched
# safely; .DS_Store and ._* below cover the macOS cruft that actually turns up.
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# LOGS AND CACHE
# =============================================================================

# Log files
*.log
logs/
sites/*/logs/
web/sites/*/logs/
docroot/sites/*/logs/

# Cache directories
cache/
sites/*/cache/
web/sites/*/cache/
docroot/sites/*/cache/

# Drupal specific cache and temporary files
sites/default/files/css/
sites/default/files/js/
web/sites/default/files/css/
web/sites/default/files/js/
docroot/sites/default/files/css/
docroot/sites/default/files/js/

# =============================================================================
# SECURITY AND SECRETS
# =============================================================================

# SSL certificates and keys
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pem

# API keys and secrets
auth.json
secrets.json
api_keys.txt
*.secret

# Configuration management secrets
!files/sync
!files/sync/*
!sites/*/files/sync
!sites/*/files/sync/*
!web/sites/*/files/sync
!web/sites/*/files/sync/*
!docroot/sites/*/files/sync
!docroot/sites/*/files/sync/*

# =============================================================================
# BUILD AND DEPLOYMENT
# =============================================================================

# Deployment scripts with sensitive information
deploy.php
capfile
fabfile.py

# CI/CD generated files
.circleci/
.github/workflows/
.gitlab-ci.yml
.travis.yml
jenkinsfile

# Docker
.docker/
docker-compose.override.yml
.dockerignore

# Vagrant
.vagrant/
Vagrantfile.local

# =============================================================================
# PERFORMANCE AND OPTIMIZATION
# =============================================================================

# Aggregated CSS and JS files
sites/*/files/css/
sites/*/files/js/
web/sites/*/files/css/
web/sites/*/files/js/
docroot/sites/*/files/css/
docroot/sites/*/files/js/

# Image style derivatives
sites/*/files/styles/
web/sites/*/files/styles/
docroot/sites/*/files/styles/

# Search index files
sites/*/files/search_api/
web/sites/*/files/search_api/
docroot/sites/*/files/search_api/

# =============================================================================
# RECIPIES
# =============================================================================
recipes/*

# drupal_cms_starter is not managed by Composer (no drupal-recipe package is
# required for it), so there is nothing for composer-patches to hook into.
# Track the specific files we've had to hand-fix to correct component-version
# hash drift/missing required props (relative to the currently installed
# drupal/mercury + drupal/canvas versions) directly in git, so they aren't
# silently lost/reverted. See patches/drupal-cms-starter-recipe-fixes.patch
# for a reviewable diff of these exact changes.
!recipes/drupal_cms_starter/
recipes/drupal_cms_starter/*
!recipes/drupal_cms_starter/config/
!recipes/drupal_cms_starter/content/
recipes/drupal_cms_starter/config/*
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.cta.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.card.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.image.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.card-logo.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.card-icon.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.card-testimonial.yml
!recipes/drupal_cms_starter/config/canvas.component.sdc.mercury.heading.yml
!recipes/drupal_cms_starter/config/canvas.page_region.mercury.footer.yml
!recipes/drupal_cms_starter/config/canvas.page_region.mercury.header.yml
!recipes/drupal_cms_starter/config/canvas.content_template.node.page.full.yml
recipes/drupal_cms_starter/content/*
!recipes/drupal_cms_starter/content/canvas_page/
recipes/drupal_cms_starter/content/canvas_page/*
!recipes/drupal_cms_starter/content/canvas_page/home.yml

# =============================================================================
# CUSTOM EXCEPTIONS (UNCOMMENT AS NEEDED)
# =============================================================================

# If you want to track specific contributed modules for custom patches
# !web/modules/contrib/specific_module/

# If you want to track custom libraries
# !web/libraries/custom_library/

# If you want to track specific configuration files
# !sites/default/settings.php.example
# !web/sites/default/settings.php.example
# Allow specific patch files to be tracked
!patches/*.patch

.gitmodules
web/modules/custom/*/.git
docroot/modules/custom/*/.git


# HiveLog — independent repo, managed via Composer
web/modules/hivelog/

# QuickSilver — independent repo, managed via Composer
web/themes/custom/quick_silver/*
web/themes/contrib/quick_silver/*
web/themes/custom/zwarte_piet/*
web/themes/contrib/zwarte_piet/*
