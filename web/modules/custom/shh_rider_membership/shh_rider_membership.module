<?php

/**
 * @file
 * Implements 0003-rider-membership-eligibility-workflow.md, see docs.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_form_FORM_ID_alter() for bee_add_reservation_form.
 *
 * Blocks booking for a rider without an active membership. Two layers,
 * deliberately:
 * - A #validate handler is the actual hard block — the same technique
 *   shh_facility_slots already uses on this exact form
 *   (shh_facility_slots_validate_slot_duration()), a plain Form API
 *   #validate callback that works regardless of which base class the
 *   form extends (bee's AddReservationForm is a plain FormBase, not a
 *   ContentEntityForm, so the commerce_order.availability_checker
 *   service pattern used in shh_horse_sale_state for horse purchases
 *   doesn't apply here — that pipeline is never invoked for this form).
 * - Hiding the submit button and showing the reason inline is a UX
 *   nicety layered on top (mirrors shh_horse_deposit's PayDepositForm),
 *   not the security boundary — the #validate handler still runs even
 *   if this were somehow bypassed.
 */
function shh_rider_membership_form_bee_add_reservation_form_alter(array &$form, FormStateInterface $form_state) {
  $uid = (int) \Drupal::currentUser()->id();
  if (!$uid) {
    // Anonymous can't even reach this form (route access already requires
    // the `create bee reservation` permission, granted only to
    // authenticated) — nothing for this module to add.
    return;
  }

  $manager = \Drupal::service('shh_rider_membership.manager');
  if ($manager->isEligible($uid)) {
    return;
  }

  $message = $manager->getEligibilityMessage($uid);
  $form['shh_membership_notice'] = [
    '#markup' => '<p>' . $message . '</p>',
    '#weight' => -100,
  ];

  if ($manager->canSelfServiceResubmit($uid)) {
    $form['shh_membership_waiver_link'] = [
      '#type' => 'component',
      '#component' => 'hestehoj:button',
      '#props' => [
        'variant' => 'secondary',
        'size' => 'medium',
        'label' => t('Submit the waiver form'),
        'href' => Url::fromRoute('entity.webform.canonical', ['webform' => 'shh_rider_waiver'])->toString(),
      ],
      '#weight' => -99,
    ];
  }

  // bee's AddReservationForm puts its submit button directly at
  // $form['submit'], not the conventional $form['actions']['submit'].
  $form['submit']['#access'] = FALSE;
  $form['#validate'][] = 'shh_rider_membership_validate_eligibility';
}

/**
 * Validate callback for bee_add_reservation_form — the real hard block.
 */
function shh_rider_membership_validate_eligibility(array &$form, FormStateInterface $form_state) {
  $uid = (int) \Drupal::currentUser()->id();
  $manager = \Drupal::service('shh_rider_membership.manager');
  if ($manager->isEligible($uid)) {
    // Re-check rather than trust the buildForm()-time result: eligibility
    // could change between form build and submission (e.g. two tabs, one
    // just approved by staff) — fail open here since this direction (was
    // ineligible, now eligible) is never the risk.
    return;
  }
  $form_state->setErrorByName('', $manager->getEligibilityMessage($uid));
}

/**
 * Implements hook_ENTITY_TYPE_insert() for webform_submission.
 *
 * Creates a pending membership the moment a rider submits the liability
 * waiver — see MembershipManager::createPendingFromWaiver() for the
 * duplicate-prevention logic.
 */
function shh_rider_membership_webform_submission_insert(WebformSubmissionInterface $webform_submission) {
  if ($webform_submission->getWebform()->id() !== 'shh_rider_waiver') {
    return;
  }
  \Drupal::service('shh_rider_membership.manager')->createPendingFromWaiver($webform_submission);
}

/**
 * Implements hook_cron().
 *
 * Sweeps active memberships past their expiry date to "expired" — see
 * MembershipManager::autoExpireStale().
 */
function shh_rider_membership_cron() {
  \Drupal::service('shh_rider_membership.manager')->autoExpireStale();
}
