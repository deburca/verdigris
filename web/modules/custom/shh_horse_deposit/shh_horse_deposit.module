<?php

/**
 * @file
 * Implements docs/project-management/tasks/0001-horse-deposit-reservation-flow.md.
 */

use Drupal\commerce_order\Entity\OrderItemInterface;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\Core\Url;

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 *
 * Adds a "Pay a deposit instead" link to a horse product's rendered output,
 * alongside the standard add-to-cart-for-full-price form, when the
 * variation is currently depositable.
 */
function shh_horse_deposit_commerce_product_view(array &$build, ProductInterface $product, $display, $view_mode) {
  if ($product->bundle() !== 'horse') {
    return;
  }
  $variation = $product->getDefaultVariation();
  if (!$variation || !\Drupal::service('shh_horse_deposit.manager')->isDepositable($variation)) {
    return;
  }
  $build['shh_pay_deposit_link'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['mb-3']],
    '#weight' => 100,
    'link' => [
      '#type' => 'component',
      '#component' => 'hestehoj:button',
      '#props' => [
        'variant' => 'secondary',
        'size' => 'medium',
        'label' => t('Pay a deposit to reserve instead'),
        'href' => Url::fromRoute('shh_horse_deposit.pay_deposit', ['commerce_product' => $product->id()])->toString(),
      ],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_order_item.
 *
 * Adds a "Cancel deposit" link to a "horse_deposit" order item's rendered
 * output when the current user has access to cancel it.
 */
function shh_horse_deposit_commerce_order_item_view(array &$build, OrderItemInterface $order_item, $display, $view_mode) {
  if ($order_item->bundle() !== 'horse_deposit') {
    return;
  }
  $access = \Drupal::service('access_manager')->checkNamedRoute(
    'shh_horse_deposit.cancel_deposit',
    ['commerce_order_item' => $order_item->id()],
    \Drupal::currentUser()
  );
  if (!$access) {
    return;
  }
  $build['shh_cancel_deposit_link'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['mb-3']],
    '#weight' => 100,
    'link' => [
      '#type' => 'component',
      '#component' => 'hestehoj:button',
      '#props' => [
        // No "destructive" variant exists on the shared button component;
        // "secondary" (visually the least prominent) is the closest fit
        // for a cancel action without adding a new variant just for this.
        'variant' => 'secondary',
        'size' => 'medium',
        'label' => t('Cancel deposit'),
        'href' => Url::fromRoute('shh_horse_deposit.cancel_deposit', ['commerce_order_item' => $order_item->id()])->toString(),
      ],
    ],
  ];
}
