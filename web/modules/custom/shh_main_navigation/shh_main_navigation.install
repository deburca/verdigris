<?php

/**
 * @file
 * Install hooks for shh_main_navigation.
 */

use Drupal\block\Entity\Block;

/**
 * Implements hook_install().
 *
 * Places this module's ShhNavbarBlock (the theme's slotted
 * `hestehoj:navbar` SDC composed in custom code — task 0032's chosen
 * mechanism) in the hestehoj `header` region. Originally (task 0019)
 * this placed a plain system_menu_block:main instead — the minimal fix
 * for the site having no rendered navigation at all; if that legacy
 * block is still present it is replaced here, keeping this hook a
 * correct bootstrap for both fresh installs and reinstalls over the
 * pre-0032 state.
 */
function shh_main_navigation_install() {
  // Pre-0032 placement of the plain menu block; superseded.
  if ($legacy = Block::load('hestehoj_main_navigation')) {
    $legacy->delete();
  }

  if (!Block::load('hestehoj_navbar')) {
    Block::create([
      'id' => 'hestehoj_navbar',
      'theme' => 'hestehoj',
      'region' => 'header',
      'weight' => 0,
      'status' => TRUE,
      'plugin' => 'shh_navbar',
      'settings' => [
        'id' => 'shh_navbar',
        'label' => 'SHH navbar',
        'label_display' => '0',
        'provider' => 'shh_main_navigation',
      ],
      'visibility' => [],
    ])->save();
  }
}
