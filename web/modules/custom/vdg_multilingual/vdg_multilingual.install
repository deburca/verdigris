<?php

/**
 * @file
 * Install hooks for vdg_multilingual.
 */

/**
 * Implements hook_install().
 *
 * On a fresh deploy the module is enabled by config import; pull in the
 * committed Danish interface translations straight away so the site does not
 * depend on outbound access to localize.drupal.org.
 */
function vdg_multilingual_install(): void {
  \Drupal::messenger()->addStatus(vdg_multilingual_import_interface_translations());
}
