<?php

/**
 * @file
 * Install hooks for shh_rider_registration.
 */

use Drupal\menu_link_content\Entity\MenuLinkContent;

/**
 * Implements hook_install().
 *
 * Two things, both idempotent:
 *
 * 1. Opens self-registration with mandatory admin approval
 *    (`user.settings: register: visitors_admin_approval`) — the client
 *    decision on task 0026. `verify_mail` stays TRUE (the Drupal CMS
 *    default): a registrant sets no password up front; once staff
 *    approve the account, core emails a one-time login link. Note this
 *    is deliberately per-site config: only shh opens registration, the
 *    other sites in this multisite keep the `admin_only` default.
 *
 * 2. Adds a "Log in / Register" link to the `main` menu, after the
 *    existing Home/Horses/Facilities links. Points at /user/login:
 *    core's user.login route requires an *anonymous* session, and menu
 *    links are access-filtered per user, so the link hides itself
 *    automatically for logged-in riders — no visibility conditions or
 *    custom code needed. The login page links onward to registration
 *    once registration is open (verified as part of 0026).
 *
 * Riders who register still start with no membership: the 0003 waiver →
 * pending → staff-approval flow is unchanged and remains the actual
 * booking gate. Account approval and membership approval are two
 * deliberate, separate staff checkpoints (decided under 0026: the
 * waiver is NOT folded into registration — revisit only if staff find
 * double approval too heavy in practice).
 */
function shh_rider_registration_install() {
  // Multisite guard: this module changes a per-site registration policy
  // decided for shh only. On any other site in this codebase, installing
  // it must be a no-op — there is no theme-scoped inertness here (unlike
  // shh_main_navigation's hestehoj-keyed block), so guard explicitly.
  if (!_shh_rider_registration_is_shh_site()) {
    \Drupal::logger('shh_rider_registration')->notice(
      'Not the shh site; leaving registration settings untouched.'
    );
    return;
  }

  \Drupal::configFactory()->getEditable('user.settings')
    ->set('register', 'visitors_admin_approval')
    ->save();

  $link_storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $existing = $link_storage->loadByProperties([
    'menu_name' => 'main',
    'link.uri' => 'internal:/user/login',
  ]);
  if (!$existing) {
    MenuLinkContent::create([
      'title' => 'Log in / Register',
      'link' => ['uri' => 'internal:/user/login'],
      'menu_name' => 'main',
      // After Home (0), Horses for sale (10), Book a facility (20).
      'weight' => 30,
      'enabled' => TRUE,
    ])->save();
  }
}

/**
 * Implements hook_uninstall().
 *
 * Uninstalling this module must actually close what it opened: restore
 * the platform's `admin_only` registration default (the value this
 * module changed from) and remove the "Log in / Register" menu link, so
 * the site does not keep accepting self-registrations — or advertising
 * a Register path — after the feature is removed. Same site guard as
 * install: if install no-op'd on a non-shh site, uninstall must not
 * touch that site's settings either.
 */
function shh_rider_registration_uninstall() {
  if (!_shh_rider_registration_is_shh_site()) {
    return;
  }

  \Drupal::configFactory()->getEditable('user.settings')
    ->set('register', 'admin_only')
    ->save();

  $link_storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $links = $link_storage->loadByProperties([
    'menu_name' => 'main',
    'link.uri' => 'internal:/user/login',
  ]);
  $link_storage->delete($links);
}

/**
 * Whether the current site is shh (multisite: config is per-site).
 */
function _shh_rider_registration_is_shh_site(): bool {
  return \Drupal::getContainer()->getParameter('site.path') === 'sites/shh';
}
