<?php

/**
 * @file
 * Install hooks for shh_site_footer.
 */

use Drupal\block\Entity\Block;
use Drupal\system\Entity\Menu;

/**
 * Implements hook_install().
 *
 * Two things, both idempotent:
 *
 * 1. Adds a "Contact us" link (to the pre-existing `contact` webform at
 *    /form/contact, decision 0009) to the `footer` menu. The menu already
 *    ships with Drupal CMS ("Privacy policy", plus a disabled "My privacy
 *    settings" placeholder) but the contact form has never been linked
 *    from any page, menu, or footer on this site.
 *
 * 2. Ensures the `social` menu exists with the 0032 placeholder
 *    Facebook/Instagram links (client to confirm the real profile URLs
 *    — tracked on task 0032; the links are content, so staff can edit
 *    them without a deploy).
 *
 * 3. Places this module's ShhFooterBlock (the theme's slotted
 *    `hestehoj:footer` SDC composed in custom code — task 0032's chosen
 *    mechanism) in the hestehoj `footer` region, replacing the plain
 *    system_menu_block:footer this hook placed before 0032 if it is
 *    still present.
 */
function shh_site_footer_install() {
  // After "Privacy policy" (weight 0).
  shh_common_ensure_menu_link('footer', 'internal:/form/contact', 'Contact us', 10);

  if (!Menu::load('social')) {
    Menu::create([
      'id' => 'social',
      'label' => 'Social media',
      'description' => 'Social profile links shown in the footer (task 0032). Placeholder URLs pending client confirmation.',
    ])->save();
  }
  shh_common_ensure_menu_link('social', 'https://www.facebook.com/stutterihestehoj', 'Facebook', 0);
  shh_common_ensure_menu_link('social', 'https://www.instagram.com/stutterihestehoj', 'Instagram', 10);

  // Pre-0032 placement of the plain menu block; superseded.
  if ($legacy = Block::load('hestehoj_footer_menu')) {
    $legacy->delete();
  }

  if (!Block::load('hestehoj_footer_sdc')) {
    Block::create([
      'id' => 'hestehoj_footer_sdc',
      'theme' => 'hestehoj',
      'region' => 'footer',
      'weight' => 0,
      'status' => TRUE,
      'plugin' => 'shh_footer',
      'settings' => [
        'id' => 'shh_footer',
        'label' => 'SHH footer',
        'label_display' => '0',
        'provider' => 'shh_site_footer',
      ],
      'visibility' => [],
    ])->save();
  }
}
