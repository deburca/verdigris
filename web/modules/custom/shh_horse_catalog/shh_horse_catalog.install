<?php

/**
 * @file
 * Install hooks for shh_horse_catalog.
 */

use Drupal\menu_link_content\Entity\MenuLinkContent;

/**
 * Implements hook_install().
 *
 * Links the new catalog page from the main navigation — per this
 * project's own gap analysis (shh-customer-facing-pages.md), the main
 * menu currently has only a single "Home" link, so there's no existing
 * structure to slot into; this is simply the first real nav item.
 */
function shh_horse_catalog_install() {
  $existing = \Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties([
    'menu_name' => 'main',
    'link.uri' => 'internal:/horses',
  ]);
  if ($existing) {
    return;
  }

  MenuLinkContent::create([
    'title' => 'Horses for sale',
    'link' => ['uri' => 'internal:/horses'],
    'menu_name' => 'main',
    'weight' => 10,
  ])->save();
}
