<?php

/**
 * @file
 * Hooks for shh_facilities_overview.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_ENTITY_TYPE_view() for node.
 *
 * Adds the hero image carousel to bookable facility pages, as the very
 * first content element — supersedes task 0040's "Photos" grid section,
 * reusing task 0039's shared media-list helper. Weighted below every
 * other element added here so it renders first regardless of what else
 * the display or other modules contribute.
 */
function shh_facilities_overview_node_view(array &$build, EntityInterface $node, EntityViewDisplayInterface $display, $view_mode) {
  /** @var \Drupal\node\NodeInterface $node */
  if ($node->bundle() !== 'bookable_facility' || !in_array($display->getMode(), ['default', 'full'], TRUE)) {
    return;
  }

  $items = [];
  foreach (shh_common_image_media_list($node, 'field_media') as $media) {
    $items[] = shh_common_image_media_props_from_media($media);
  }
  if (!$items) {
    return;
  }

  $build['shh_hero'] = [
    '#type' => 'component',
    '#component' => 'hestehoj:image-carousel',
    '#props' => ['items' => $items],
    '#weight' => -100,
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for node.
 *
 * Regroups the facility facts (name/kind/surface/etc.) and the
 * booking-related elements (book now / buy credit pack / open hours) —
 * contributed independently by the display's field formatters and by
 * shh_facility_booking_cta / shh_facility_credits — into one side-by-side
 * row, with the availability calendar left as its own full-width element
 * underneath. Runs as an _alter hook (not _view) specifically so it fires
 * after every module's own hook_ENTITY_TYPE_view() has already added its
 * piece to $build, regardless of module weight.
 */
function shh_facilities_overview_node_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($entity->bundle() !== 'bookable_facility' || !in_array($display->getMode(), ['default', 'full'], TRUE)) {
    return;
  }

  $info_keys = [
    'field_facility_kind',
    'field_surface',
    'field_dimensions',
    'field_indoor',
    'field_capacity',
    'field_peak_pricing_notes',
    'field_cancellation_policy',
    'field_slot_duration_minutes',
  ];
  $booking_keys = [
    'shh_book_now_link',
    'shh_buy_credit_pack_link',
    'field_open_hours',
  ];

  $info = [
    '#type' => 'container',
    '#attributes' => ['class' => ['flex', 'flex-col', 'gap-3', 'flex-1']],
    'heading' => [
      '#type' => 'component',
      '#component' => 'hestehoj:heading',
      '#props' => [
        'heading_text' => $entity->label(),
        'level' => 2,
        'text_size' => 'heading-responsive-3xl',
        'text_color' => 'default',
        'align' => 'left',
      ],
      '#weight' => -10,
    ],
  ];
  $booking = [
    '#type' => 'container',
    '#attributes' => ['class' => ['flex', 'flex-col', 'gap-3', 'flex-1']],
  ];

  $found = FALSE;
  foreach ($info_keys as $key) {
    if (isset($build[$key])) {
      $info[$key] = $build[$key];
      unset($build[$key]);
      $found = TRUE;
    }
  }
  foreach ($booking_keys as $key) {
    if (isset($build[$key])) {
      $booking[$key] = $build[$key];
      unset($build[$key]);
      $found = TRUE;
    }
  }
  if (!$found) {
    // Nothing to regroup (shouldn't normally happen for a real facility
    // node) — leave $build untouched rather than add an empty row.
    return;
  }

  $build['shh_facility_summary'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['flex', 'flex-col', 'gap-8', 'md:flex-row', 'md:items-start', 'mb-8']],
    '#weight' => 10,
    'info' => $info,
    'booking' => $booking,
  ];

  shh_facilities_overview_attach_meta_tags($build, $entity);
}

/**
 * Attaches a meta description (task 0054) for one facility's own page.
 *
 * Composed the same way FacilityCardBuilder::buildCard() builds its
 * card summary — kind, indoor/outdoor, capacity, per-slot price — but
 * inline here rather than sharing that method, since the card's summary
 * is Commerce-price-formatted for a compact card string and this needs
 * a full sentence; duplicating three field reads is simpler than
 * awkwardly reusing the card's shorter string.
 */
function shh_facilities_overview_attach_meta_tags(array &$build, EntityInterface $node): void {
  $parts = [];
  if ($node->hasField('field_facility_kind') && !$node->get('field_facility_kind')->isEmpty()) {
    $allowed_values = $node->get('field_facility_kind')->getFieldDefinition()
      ->getFieldStorageDefinition()->getSetting('allowed_values');
    $value = $node->get('field_facility_kind')->value;
    $parts[] = $allowed_values[$value] ?? $value;
  }
  if ($node->hasField('field_indoor') && !$node->get('field_indoor')->isEmpty()) {
    $parts[] = $node->get('field_indoor')->value ? t('indoor') : t('outdoor');
  }
  if ($node->hasField('field_capacity') && !$node->get('field_capacity')->isEmpty()) {
    $parts[] = \Drupal::translation()->formatPlural(
      (int) $node->get('field_capacity')->value,
      'capacity 1 rider',
      'capacity @count riders',
    );
  }

  $pricing_helper = \Drupal::service('shh_facility_credits.pricing_helper');
  $slot_price = $pricing_helper->getSlotPrice($node);
  if ($slot_price && $node->hasField('field_slot_duration_minutes')) {
    $formatted_price = \Drupal::service('commerce_price.currency_formatter')
      ->format($slot_price->getNumber(), $slot_price->getCurrencyCode());
    $parts[] = t('@price per @minutes-minute slot', [
      '@price' => $formatted_price,
      '@minutes' => (int) $node->get('field_slot_duration_minutes')->value,
    ]);
  }

  if (!$parts) {
    return;
  }
  $description = (string) t('Book the @name at Stutteri Hestehøj — @facts. Book online, pay as you ride.', [
    '@name' => $node->label(),
    '@facts' => implode(', ', $parts),
  ]);

  $image_url = NULL;
  $image_alt = NULL;
  $media_list = shh_common_image_media_list($node, 'field_media');
  if ($media_list) {
    $media = reset($media_list);
    $image_url = shh_common_absolute_image_url($media);
    $image_alt = shh_common_image_media_props_from_media($media)['alt'] ?? NULL;
  }

  $build['#attached'] ??= [];
  shh_common_attach_meta_tags($build['#attached'], $node->label(), $description, $image_url, $image_alt);
}
