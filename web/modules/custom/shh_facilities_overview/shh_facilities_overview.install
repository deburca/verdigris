<?php

/**
 * @file
 * Install hooks for shh_facilities_overview.
 */

/**
 * Implements hook_install().
 *
 * Links the new overview page from the main navigation, alongside the
 * horse catalog link added by shh_horse_catalog (0019) — see that
 * module's own install hook for why the main menu needed a block placed
 * at all before either link would be visible (shh_main_navigation).
 */
function shh_facilities_overview_install() {
  // After Home (0) and Horses for sale (10).
  shh_common_ensure_menu_link('main', 'internal:/facilities', 'Book a facility', 20);
}
