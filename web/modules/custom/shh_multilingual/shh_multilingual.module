<?php

/**
 * @file
 * Interface-translation deploy plumbing for stutteri-hestehoj.dk (task 0069).
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\locale\Gettext;

/**
 * Implements hook_ENTITY_TYPE_insert() for configurable_language.
 *
 * On a first deploy the multilingual modules and this one are installed during
 * the config import's `processExtensions` step, which runs to completion
 * *before* `processConfigurations` creates `language.entity.da`. So
 * hook_install() runs while `da` still does not exist and skips. This catches
 * the language the moment it is created — during that same cim, or later via
 * `drush language:add da` / the UI — and pulls the committed .po in then.
 * Idempotent; only acts on `da`.
 */
function shh_multilingual_configurable_language_insert(EntityInterface $language): void {
  if ($language->id() === 'da') {
    \Drupal::messenger()->addStatus(shh_multilingual_import_interface_translations());
  }
}

/**
 * Imports the committed Danish .po into {locales_target}.
 *
 * Configuration sync (cex/cim) does not carry interface translations, so the
 * ~8.7k Danish strings that `drush language:add da` fetched from
 * localize.drupal.org only live in this site's database. This ships a snapshot as a
 * repo artifact and re-applies it on install, on language creation, and on
 * every `drush deploy` (see the .install / .deploy.php files).
 *
 * Imported as LOCALE_NOT_CUSTOMIZED with overwrite limited to not-customized
 * rows: a translation a human later edits in the UI (customized) is never
 * clobbered, and a future `drush locale:update` can still pull newer
 * community strings on top.
 *
 * Idempotent — safe to run on every deploy; a no-op if the `da` language or
 * the .po file is absent.
 */
function shh_multilingual_import_interface_translations(): string {
  $langcode = 'da';

  if (!\Drupal::languageManager()->getLanguage($langcode)) {
    return "Language '$langcode' not installed yet — skipped .po import.";
  }

  $uri = \Drupal::service('extension.list.module')->getPath('shh_multilingual')
    . '/translations/' . $langcode . '.po';
  if (!is_file($uri)) {
    return "No committed translation file at $uri — skipped.";
  }

  $file = new \stdClass();
  $file->filename = basename($uri);
  $file->uri = $uri;
  $file->langcode = $langcode;

  $report = Gettext::fileToDatabase($file, [
    'langcode' => $langcode,
    'customized' => LOCALE_NOT_CUSTOMIZED,
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
  ]);

  // Regenerate the client-side translation files and drop caches that hold
  // rendered translated strings.
  _locale_rebuild_js($langcode);
  \Drupal\Core\Cache\Cache::invalidateTags(['rendered', 'locale']);

  return sprintf(
    "Imported shh_multilingual/translations/%s.po: %d added, %d updated, %d deleted.",
    $langcode,
    $report['additions'] ?? 0,
    $report['updates'] ?? 0,
    $report['deletes'] ?? 0,
  );
}

/**
 * Seeds Danish (`da`) translations of the site's menu-link titles (task 0069).
 *
 * Menu-link titles are content, not config, so cex/cim does not carry them.
 * This is the mechanical, high-visibility subset (every page shows the menu);
 * the map is the source of truth. Idempotent — only adds a `da` translation
 * where the link's title matches and none exists yet.
 */
function shh_multilingual_seed_da_menu_links(): string {
  if (!\Drupal::languageManager()->getLanguage('da')) {
    return "Language 'da' not installed yet — skipped menu seeding.";
  }
  $map = [
    'Privacy policy' => 'Privatlivspolitik',
    'My privacy settings' => 'Mine privatlivsindstillinger',
    'Contact us' => 'Kontakt os',
    'Home' => 'Forsiden',
    'Book a facility' => 'Book en facilitet',
    'Log in / Register' => 'Log ind / Opret konto',
    'Horses for sale' => 'Heste til salg',
    'Feed & bedding' => 'Foder og strøelse',
  ];
  $n = 0;
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  foreach ($storage->loadMultiple() as $link) {
    $title = $link->getTitle();
    if (!isset($map[$title]) || $link->hasTranslation('da')) {
      continue;
    }
    $link->addTranslation('da', ['title' => $map[$title]])->save();
    $n++;
  }
  return "Seeded $n da menu-link translation(s).";
}
