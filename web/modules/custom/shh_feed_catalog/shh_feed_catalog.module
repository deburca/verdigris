<?php

/**
 * @file
 * Hooks for shh_feed_catalog.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 *
 * Adds the all-images photo gallery to feed product pages (task 0039).
 * A plain view hook, not the view_alter takeover shh_horse_product_display
 * needs — feed pages keep their classic field-formatter display and the
 * gallery is just one more section, the same sibling-hook mechanism as
 * the facility/deposit CTAs.
 *
 * Images live on the variations (one per harvest year, task 0038), but
 * photos belong to the product, not the year — so the gallery is the
 * union of every published variation's images, deduped by media entity,
 * in variation-then-delta order.
 */
function shh_feed_catalog_commerce_product_view(array &$build, EntityInterface $product, EntityViewDisplayInterface $display, $view_mode) {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  if ($product->bundle() !== 'feed' || !in_array($display->getMode(), ['default', 'full'], TRUE)) {
    return;
  }

  $cacheability = CacheableMetadata::createFromRenderArray($build);
  $media_by_id = [];
  foreach ($product->getVariations() as $variation) {
    $cacheability->addCacheableDependency($variation);
    if (!$variation->isPublished() || !$variation->hasField('field_media')) {
      continue;
    }
    foreach ($variation->get('field_media')->referencedEntities() as $media) {
      $media_by_id[$media->id()] ??= $media;
    }
  }
  $cacheability->applyTo($build);

  $gallery = shh_common_image_gallery(array_values($media_by_id));
  if ($gallery) {
    // Between the body (5) and the add-to-cart form (10) in the feed
    // product view display.
    $build['shh_photos'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['flex', 'flex-col', 'gap-3', 'mb-8']],
      '#weight' => 7,
      'heading' => [
        '#type' => 'component',
        '#component' => 'hestehoj:heading',
        '#props' => [
          'heading_text' => (string) t('Photos'),
          'level' => 2,
          'text_size' => 'heading-responsive-2xl',
          'text_color' => 'default',
          'align' => 'left',
        ],
      ],
      'grid' => $gallery,
    ];
  }

  _shh_feed_catalog_attach_meta_tags($build, $product, array_values($media_by_id));
}

/**
 * Attaches a meta description/Open Graph tags for a feed product page.
 *
 * See shh_common_attach_meta_tags() (task 0054) for why this is
 * hand-composed rather than via Metatag tokens. Mirrors
 * FeedCardBuilder::buildCard()'s summary (body teaser + cheapest
 * published price) rather than sharing it directly — that method
 * returns a full card render array, not just the text, and a full
 * sentence description reads differently than a compact card string.
 */
function _shh_feed_catalog_attach_meta_tags(array &$build, EntityInterface $product, array $media_list): void {
  $parts = [];
  if ($product->hasField('body') && !$product->get('body')->isEmpty()) {
    $body = $product->get('body')->first();
    $teaser = trim(preg_replace('/\s+/', ' ', strip_tags($body->summary ?: $body->value)));
    if ($teaser !== '') {
      $parts[] = mb_strlen($teaser) > 150 ? mb_substr($teaser, 0, 149) . '…' : $teaser;
    }
  }

  $prices = [];
  foreach ($product->getVariations() as $variation) {
    if ($variation->isPublished() && $variation->getPrice()) {
      $prices[] = $variation->getPrice();
    }
  }
  if ($prices) {
    usort($prices, fn ($a, $b) => $a->compareTo($b));
    $formatted = \Drupal::service('commerce_price.currency_formatter')
      ->format($prices[0]->getNumber(), $prices[0]->getCurrencyCode());
    $parts[] = end($prices)->equals($prices[0])
      ? (string) t('@price per bale', ['@price' => $formatted])
      : (string) t('From @price per bale', ['@price' => $formatted]);
  }

  if (!$parts) {
    return;
  }
  $description = (string) t('@name at Stutteri Hestehøj — @facts. Pickup only.', [
    '@name' => $product->label(),
    '@facts' => implode(', ', $parts),
  ]);

  $image_url = NULL;
  $image_alt = NULL;
  if ($media_list) {
    $media = reset($media_list);
    $image_url = shh_common_absolute_image_url($media);
    $image_alt = shh_common_image_media_props_from_media($media)['alt'] ?? NULL;
  }

  $build['#attached'] ??= [];
  shh_common_attach_meta_tags($build['#attached'], $product->label(), $description, $image_url, $image_alt);
}
