<?php

/**
 * @file
 * Shared helpers for the shh module family.
 */

use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Url;
use Drupal\media\MediaInterface;
use Symfony\Component\Routing\Exception\RouteNotFoundException;

/**
 * Resolves a list_string field's values to their human-readable labels.
 *
 * Factored out of HorseCatalogController (task 0031): machine values
 * like "flying_pace" are resolved through the field storage's own
 * allowed_values map, falling back to the raw value for anything
 * unmapped.
 *
 * @return string[]
 *   Labels in field delta order; empty array for an empty field.
 */
function shh_common_list_string_labels(FieldItemListInterface $items): array {
  if ($items->isEmpty()) {
    return [];
  }
  $allowed_values = $items->getFieldDefinition()
    ->getFieldStorageDefinition()->getSetting('allowed_values') ?? [];
  return array_map(
    fn ($item) => (string) ($allowed_values[$item->value] ?? $item->value),
    iterator_to_array($items),
  );
}

/**
 * Builds hestehoj media props from an entity's first image-media item.
 *
 * The `{src, alt, width, height}` shape hestehoj components' `media`
 * prop expects. Factored out of HorseCatalogController (task 0031);
 * only image media is meaningful. Since task 0039 this is the
 * "featured image" accessor — the first *image* item in field delta
 * order (a leading video no longer hides a later image), which is the
 * platform's definition of featured: staff pick it by reordering the
 * media widget.
 */
function shh_common_image_media_props(FieldableEntityInterface $entity, string $field_name): array {
  return shh_common_image_media_props_all($entity, $field_name)[0] ?? [];
}

/**
 * Builds hestehoj media props for every image-media item on a field.
 *
 * List form of shh_common_image_media_props() (task 0039): one props
 * entry per image media item, in field delta order; video/remote_video
 * items are skipped rather than erroring.
 *
 * @return array[]
 *   A list of {src, alt, width, height} prop arrays; empty when the
 *   field is missing, empty, or holds no image media.
 */
function shh_common_image_media_props_all(FieldableEntityInterface $entity, string $field_name): array {
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return [];
  }
  $props_list = [];
  foreach ($entity->get($field_name)->referencedEntities() as $media) {
    $props = shh_common_image_media_props_from_media($media);
    if ($props) {
      $props_list[] = $props;
    }
  }
  return $props_list;
}

/**
 * Builds hestehoj media props from one media entity.
 *
 * Lowest-level piece of the task 0039 helper family, public so callers
 * aggregating media across several entities (shh_feed_catalog's
 * per-year variations) can dedupe media themselves and still share the
 * props construction. The `src` is canvas's computed
 * src_with_alternate_widths property, so it serves responsive widths.
 *
 * @param \Drupal\Core\Entity\EntityInterface|null $media
 *   A media entity (anything else returns []).
 *
 * @return array
 *   {src, alt, width, height} props, or [] for anything that isn't
 *   image media with a file.
 */
function shh_common_image_media_props_from_media($media): array {
  if (!$media instanceof MediaInterface || $media->bundle() !== 'image' || !$media->hasField('field_media_image')) {
    return [];
  }
  $image_item = $media->get('field_media_image')->first();
  if (!$image_item) {
    return [];
  }
  return [
    'src' => (string) $image_item->get('src_with_alternate_widths')->getString(),
    'alt' => (string) $image_item->get('alt')->getValue(),
    'width' => (int) $image_item->get('width')->getValue(),
    'height' => (int) $image_item->get('height')->getValue(),
  ];
}

/**
 * Lists an entity's image-media entities, in field delta order.
 *
 * The entity-level companion to shh_common_image_media_props_all()
 * (task 0041): same filtering — only image media that would yield
 * props survive — but returns the media entities themselves, for
 * callers that need more than display props (the gallery needs the
 * original file URL too).
 *
 * @return \Drupal\media\MediaInterface[]
 *   Image media entities; empty when the field is missing, empty, or
 *   holds no usable image media.
 */
function shh_common_image_media_list(FieldableEntityInterface $entity, string $field_name): array {
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return [];
  }
  $list = [];
  foreach ($entity->get($field_name)->referencedEntities() as $media) {
    if (shh_common_image_media_props_from_media($media)) {
      $list[] = $media;
    }
  }
  return $list;
}

/**
 * Builds the shared image gallery render array from media entities.
 *
 * The product/facility-page gallery presentation (tasks 0039/0041):
 * renders the hestehoj:gallery component — a grid of uniform 1:1
 * tiles with a lightbox dialog (task 0041; supersedes 0039's
 * "grid of image components, no lightbox" once the client asked).
 * Each tile links to the original file, so without JavaScript a click
 * still shows the full image. Non-image media are skipped; returns []
 * for an empty result so callers skip gallery furniture entirely
 * (the degrade-gracefully criterion).
 *
 * @param \Drupal\media\MediaInterface[] $media_list
 *   Media entities, e.g. from shh_common_image_media_list() or a
 *   caller's own cross-entity aggregation (shh_feed_catalog).
 */
function shh_common_image_gallery(array $media_list): array {
  $file_url_generator = \Drupal::service('file_url_generator');
  $items = [];
  foreach ($media_list as $media) {
    $props = shh_common_image_media_props_from_media($media);
    if (!$props) {
      continue;
    }
    $file = $media->get('field_media_image')->entity;
    if (!$file) {
      continue;
    }
    $items[] = $props + [
      'full_src' => $file_url_generator->generateString($file->getFileUri()),
    ];
  }
  if (!$items) {
    return [];
  }
  return [
    '#type' => 'component',
    '#component' => 'hestehoj:gallery',
    '#props' => [
      'items' => $items,
    ],
  ];
}

/**
 * The post-cancellation landing URL for an order's owner (task 0029).
 *
 * The rider dashboard (task 0022) is the natural "my bookings,
 * deposits and credits" hub and is where a rider realistically clicked
 * "Cancel" from — 0015's booking cancel and 0001's deposit cancel both
 * predate it and dumped the rider on the homepage.
 *
 * Deliberately keyed on the **order's owner**, not the current user:
 * when staff cancel on a rider's behalf they land on *that rider's*
 * dashboard (which they may view — RiderDashboardAccessCheck allows
 * `administer commerce_order`), not on their own.
 *
 * Falls back to the front page when there is no owning account (a
 * guest horse-deposit order is possible: horse checkout allows guests)
 * or if the dashboard route is unavailable, so callers can use this
 * unconditionally.
 *
 * @param int $uid
 *   The order customer's user id; 0 for a guest order.
 */
function shh_common_rider_dashboard_url(int $uid): Url {
  if ($uid > 0) {
    try {
      \Drupal::service('router.route_provider')->getRouteByName('shh_rider_dashboard.dashboard');
      return Url::fromRoute('shh_rider_dashboard.dashboard', ['user' => $uid]);
    }
    catch (RouteNotFoundException) {
      // shh_rider_dashboard not installed — fall through to the front page.
    }
  }
  return Url::fromRoute('<front>');
}

/**
 * Maps BAT unit id => ['label' => facility label, 'nid' => node id].
 *
 * The unit entities' own labels are stale (unit 1 still carries the
 * pre-rename "Outdoor Arena 1" name), so facility names come from the
 * owning bookable_facility nodes — the same unit→node resolution
 * 0002's logger established. Factored out of
 * shh_staff_booking_calendar's controller (task 0008, second
 * consumer).
 *
 * @return array[]
 *   Keyed by BAT unit id.
 */
function shh_common_bat_unit_facility_map(): array {
  $map = [];
  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
    'type' => 'bookable_facility',
  ]);
  foreach ($nodes as $node) {
    foreach (['field_availability_hourly', 'field_availability_daily'] as $field) {
      if (!$node->hasField($field)) {
        continue;
      }
      foreach ($node->get($field)->getValue() as $value) {
        $map[(int) $value['target_id']] = [
          'label' => $node->label(),
          'nid' => (int) $node->id(),
        ];
      }
    }
  }
  return $map;
}

/**
 * Ensures a menu link exists, keyed by menu name + URI.
 *
 * Idempotency contract shared by the shh install hooks (task 0035):
 * creates the link only when no menu_link_content entity with the same
 * menu and URI exists, so reinstalls never duplicate a link and an
 * existing link's title/weight/enabled state is never overwritten
 * (staff edits survive a reinstall). `enabled` is set explicitly —
 * deliberate resolution of the drift where two of the original four
 * copies relied on the field default.
 *
 * @param string $menu
 *   Menu machine name (e.g. 'main', 'footer').
 * @param string $uri
 *   Link URI (e.g. 'internal:/horses').
 * @param string $title
 *   Link title, used only when the link is created.
 * @param int $weight
 *   Menu weight, used only when the link is created.
 */
function shh_common_ensure_menu_link(string $menu, string $uri, string $title, int $weight): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $existing = $storage->loadByProperties([
    'menu_name' => $menu,
    'link.uri' => $uri,
  ]);
  if ($existing) {
    return;
  }
  $storage->create([
    'title' => $title,
    'link' => ['uri' => $uri],
    'menu_name' => $menu,
    'weight' => $weight,
    'enabled' => TRUE,
  ])->save();
}

/**
 * Attaches a meta description and basic Open Graph tags.
 *
 * A hand-rolled attachment rather than the Metatag module (task 0054):
 * Metatag is present in the codebase and already configured on vdg, but
 * only via `field_seo_*` fields none of shh's bundles have, generating
 * descriptions through token chains — and Metatag's token resolution
 * across the commerce_product → commerce_product_variation boundary
 * (where shh's actual sellable data lives) is a known-awkward path.
 * Every page needing a description here already has the exact summary
 * text computed in PHP for its card (HorseCardBuilder,
 * FacilityCardBuilder, FeedCardBuilder) or is simple enough to write by
 * hand (the four catalog pages, the homepage) — attaching it directly is
 * both simpler and more consistent with this project's "compute from
 * live data, don't hand-author copy that rots" pattern than fighting a
 * token chain for a handful of pages.
 *
 * @param array $attachments
 *   A `#attached`-shaped array (or the `$attachments` array
 *   `hook_page_attachments()` receives directly) to append `html_head`
 *   entries to, by reference.
 * @param string $title
 *   Used for `og:title` only — the `<title>` tag itself is untouched,
 *   core's own title handling already covers it correctly for every
 *   page this is called from.
 * @param string $description
 *   Plain text, no markup. A no-op if empty, so a caller can pass a
 *   possibly-blank computed string unconditionally.
 * @param string|null $image_url
 *   An absolute image URL (see shh_common_absolute_image_url()), or
 *   NULL to omit `og:image` — every page this is used on either has a
 *   real photo or reasonably has none yet (the zero-photo degrade case
 *   the image components already handle).
 */
function shh_common_attach_meta_tags(array &$attachments, string $title, string $description, ?string $image_url = NULL, ?string $image_alt = NULL, string $og_type = 'website'): void {
  $description = trim($description);
  if ($description === '') {
    return;
  }

  $tags = [
    'shh_meta_description' => ['name' => 'description', 'content' => $description],
    'shh_meta_og_title' => ['property' => 'og:title', 'content' => $title],
    'shh_meta_og_description' => ['property' => 'og:description', 'content' => $description],
    'shh_meta_og_type' => ['property' => 'og:type', 'content' => $og_type],
  ];
  if ($image_url) {
    $tags['shh_meta_og_image'] = ['property' => 'og:image', 'content' => $image_url];
    if ($image_alt) {
      $tags['shh_meta_og_image_alt'] = ['property' => 'og:image:alt', 'content' => $image_alt];
    }
  }

  foreach ($tags as $key => $tag_attributes) {
    $attachments['html_head'][] = [
      ['#tag' => 'meta', '#attributes' => $tag_attributes],
      $key,
    ];
  }
}

/**
 * An absolute URL for a media entity's image file, for use as og:image.
 *
 * Deliberately the original file, not a cropped social-share derivative
 * (vdg's `social_media_facebook`/`social_media_x` image styles use the
 * `focal_point` module, a dependency shh has no other reason to add) —
 * every consuming platform still fetches and displays the image fine
 * without a purpose-cropped size.
 */
function shh_common_absolute_image_url(?MediaInterface $media): ?string {
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_image')->entity;
  if (!$file) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
}

/**
 * Implements hook_page_attachments().
 *
 * The only page-level hook that reaches the front page regardless of
 * how it's rendered — the homepage is a Canvas page (task 0051), and
 * Canvas's page-building pipeline has no per-page hook_ENTITY_TYPE_view()
 * equivalent to hang a meta description off instead.
 */
function shh_common_page_attachments(array &$attachments): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }
  // hook_page_attachments() only permits '#attached' and '#cache' keys
  // on $attachments itself — unlike a render array, 'html_head' can't go
  // directly on it, only nested under '#attached'.
  $attachments['#attached'] ??= [];
  shh_common_attach_meta_tags(
    $attachments['#attached'],
    (string) t('Stutteri Hestehøj — Icelandic horses, riding facilities & feed'),
    (string) t('Icelandic horses for sale, hourly riding facility bookings, and feed & bedding at Stutteri Hestehøj in Holbæk — five-gaited and four-gaited horses, bred in-house.'),
  );
}
