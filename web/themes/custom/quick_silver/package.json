{
  "name": "quick_silver",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "$npm_execpath run s:tailwindcss -- --watch",
    "build": "$npm_execpath run s:tailwindcss",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "s:tailwindcss": "tailwindcss --input ./src/main.css --minify --output ./build/main.min.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@zackad/prettier-plugin-twig": "^0.17.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.1"
  },
  "dependenciesMeta": {
    "@zackad/prettier-plugin-twig@0.16.3": {
      "unplugged": true
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
