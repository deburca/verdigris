{#
/**
 * @file
 * Hero image carousel: one slide visible at a time.
 *
 * No-JS fallback: every slide but the first is `display: none` in
 * image-carousel.css, so without JavaScript the page still shows one
 * full hero image — image-carousel.js only has to add the ability to
 * switch which slide that is, not build the baseline experience.
 */
#}
{% if items %}
  <div class="image-carousel">
    <div class="image-carousel--track">
      {% for item in items %}
        <div class="image-carousel--slide{{ loop.first ? ' is-active' : '' }}">
          {{
            include(
              'hestehoj:image',
              {
                media: {
                  src: item.src,
                  alt: item.alt,
                  width: item.width,
                  height: item.height
                },
                size: '2:1',
                radius: 'large',
                bleed: 'contained'
              },
              with_context: false
            )
          }}
        </div>
      {% endfor %}
    </div>
    {% if (items|length) > 1 %}
      <button type="button" class="image-carousel--control image-carousel--prev" aria-label="{{ 'Previous image'|t }}">&#8249;</button>
      <button type="button" class="image-carousel--control image-carousel--next" aria-label="{{ 'Next image'|t }}">&#8250;</button>
      <div class="image-carousel--dots">
        {% for item in items %}
          <button
            type="button"
            class="image-carousel--dot{{ loop.first ? ' is-active' : '' }}"
            aria-label="{{ 'Show image @n'|t({
              '@n': loop.index
            }) }}"
          >

          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
