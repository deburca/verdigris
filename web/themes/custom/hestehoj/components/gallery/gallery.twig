{#
/**
 * @file
 * Image gallery: a responsive tile grid with a lightbox dialog.
 *
 * Progressive enhancement: each tile is a plain link to the original
 * file (via the image component's url prop), so without JavaScript a
 * click still shows the full image. gallery.js upgrades the links to
 * open the <dialog> lightbox with prev/next navigation instead.
 */
#}
{% set gallery_variants = html_cva(base: 'gallery') %}
{% set grid_variants = html_cva(base: 'grid grid-cols-2 gap-4 md:grid-cols-3') %}

<div class="{{ gallery_variants.apply({}) }}">
  <div class="{{ grid_variants.apply({}) }}">
    {% for item in items %}
      <div class="gallery--item" data-full-src="{{ item.full_src }}" data-alt="{{ item.alt }}">
        {{
          include(
            'hestehoj:image',
            {
              media: {
                src: item.src,
                alt: item.alt,
                width: item.width,
                height: item.height
              },
              size: '1:1',
              radius: 'large',
              bleed: 'contained',
              url: item.full_src
            },
            with_context: false
          )
        }}
      </div>
    {% endfor %}
  </div>
  <dialog class="gallery--dialog" aria-label="{{ 'Image gallery'|t }}">
    <img class="gallery--dialog-image" src="" alt="" />
    <div class="gallery--dialog-caption"></div>
    <button type="button" class="gallery--control gallery--close" aria-label="{{ 'Close'|t }}">&#215;</button>
    <button type="button" class="gallery--control gallery--prev" aria-label="{{ 'Previous image'|t }}">&#8249;</button>
    <button type="button" class="gallery--control gallery--next" aria-label="{{ 'Next image'|t }}">&#8250;</button>
  </dialog>
</div>
