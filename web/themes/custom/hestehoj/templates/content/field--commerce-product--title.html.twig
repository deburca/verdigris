{#
/**
 * @file
 * Theme override for the commerce product title field.
 *
 * Commerce products have no page-title source of their own: core's
 * EntityViewController::buildTitle() renders this field's output and
 * places it inside the page-title <h1>. That output must therefore be
 * inline markup with no styled block wrappers — this theme's generic
 * field.html.twig would nest a div with body-text sizing classes inside
 * the <h1>, visually shrinking the title back to paragraph size. This
 * is the commerce_product equivalent of core's
 * field--node--title.html.twig, keyed on the same #is_page_title flag.
 *
 * @see \Drupal\Core\Entity\Controller\EntityViewController::buildTitle()
 * @see core/modules/node/templates/field--node--title.html.twig
 */
#}
{% set is_page_title = element['#is_page_title'] is defined and element['#is_page_title'] %}
{% if is_page_title %}
  <span{{ attributes }}>
    {%- for item in items -%}
      {{ item.content }}
    {%- endfor -%}
  </span>
{% else %}
  {% include 'field.html.twig' %}
{% endif %}
