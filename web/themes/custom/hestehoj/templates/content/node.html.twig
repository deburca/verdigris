{#
/**
 * @file
 * Theme override to display a node.
 *
 * Only reached for content types not built as a Canvas page (e.g. the shh
 * "Bookable Facility" node type and, via a parallel commerce template, the
 * "Horse" product) — Canvas-built pages never hit this template at all. The
 * core default renders with no visual hierarchy in this theme (Hestehoj has
 * no base theme to inherit that styling from), so this override adds it.
 *
 * The page title itself is intentionally NOT rendered here: for the "full"
 * view mode it's already themed and printed once by
 * templates/misc/page-title.html.twig via the page's own title region —
 * this matches core's own node.html.twig, which only prints an h2 title for
 * non-full view modes (e.g. teasers).
 *
 * The "submitted by ... on ..." byline is deliberately dropped rather than
 * styled: no content on this site is presented as author-attributed
 * editorial writing (Canvas-built pages never show it either), so for
 * these operational content types (facility/product data) it would only
 * ever read as noise, not signal.
 *
 * @see web/core/modules/node/templates/node.html.twig
 */
#}
<article {{ attributes }}>

  {{ title_prefix }}
  {% if label and view_mode != "full" %}
    <h2 {{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div {{ content_attributes.addClass('space-y-1') }}>
    {{ content }}
  </div>

</article>
