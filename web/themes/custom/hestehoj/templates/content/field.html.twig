{#
/**
 * @file
 * Theme override for a field.
 *
 * The default (core) implementation renders fields with no styling classes
 * at all in this theme (Hestehoj has no base theme, and Canvas-built pages
 * never reach this template — only "plain" entity full-page views like the
 * commerce product and bookable_facility node pages do). This override adds
 * the theme's own label/value hierarchy and spacing so those pages read as
 * more than an unstyled list of label/value pairs.
 *
 * @see template_preprocess_field()
 * @see web/core/modules/system/templates/field.html.twig
 */
#}
{% set title_classes = [
  label_display == 'visually_hidden' ? 'visually-hidden',
] %}

{% set field_variants = html_cva(base: 'mb-5 last:mb-0') %}

{% set label_variants =
  html_cva(
    base: [
      'mb-1',
      'text-xs',
      'font-semibold',
      'uppercase',
      'tracking-wide',
      'text-muted-foreground'
    ]
  )
%}

{% set item_variants = html_cva(base: 'text-base text-foreground md:text-lg') %}

{% set field_class_attr = field_variants.apply({}) %}
{% set label_class_attr = label_variants.apply({}) %}
{% set item_class_attr = item_variants.apply({}) %}

{% if label_hidden %}
  {% if multiple %}
    <div {{ attributes.addClass(field_class_attr) }}>
      {% for item in items %}
        <div {{ item.attributes.addClass(item_class_attr) }}>{{ item.content }}</div>
      {% endfor %}
    </div>
  {% else %}
    {% for item in items %}
      <div {{ attributes.addClass(field_class_attr).addClass(item_class_attr) }}>{{ item.content }}</div>
    {% endfor %}
  {% endif %}
{% else %}
  <div {{ attributes.addClass(field_class_attr) }}>
    <div {{ title_attributes.addClass(title_classes).addClass(label_class_attr) }}>{{ label }}</div>
    {% if multiple %}
      <div class="space-y-1">
    {% endif %}
    {% for item in items %}
      <div {{ item.attributes.addClass(item_class_attr) }}>{{ item.content }}</div>
    {% endfor %}
    {% if multiple %}
      </div>
    {% endif %}
  </div>
{% endif %}
